        <property name="hibernate.connection.url">jdbc:postgresql://ep-round-salad-be5rjzht-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require</property>
        <property name="hibernate.connection.username">neondb_owner</property>
